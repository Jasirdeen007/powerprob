FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Preferred setup: Mosquitto runs on the Raspberry Pi.
# Set this to the Pi LAN IP, for example 192.168.1.80.
MQTT_HOST=YOUR_PI_IP
MQTT_PORT=1883
MQTT_DEFAULT_DEVICE_ID=pi-001
MQTT_HEARTBEAT_STALE_SECONDS=45

BACKEND_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
