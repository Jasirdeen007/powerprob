FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Public EMQX broker for lab testing.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=powerprobe/team6
MQTT_DEFAULT_DEVICE_ID=pi-001
MQTT_HEARTBEAT_STALE_SECONDS=45
MQTT_PREFER_IPV4=false

BACKEND_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SMTP for password reset emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
