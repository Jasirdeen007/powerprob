[Unit]
Description=PowerProbe Raspberry Pi MQTT Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/powerprobe
Environment=POWERPROBE_MQTT_HOST=127.0.0.1
Environment=POWERPROBE_MQTT_PORT=1883
Environment=POWERPROBE_DEVICE_ID=pi-001
Environment=POWERPROBE_BATTERY_ID=B0047
Environment=POWERPROBE_STATE_FILE=/home/pi/powerprobe/latest_profile.json
ExecStart=/usr/bin/python3 -u /home/pi/powerprobe/powerprobe_pi_mqtt.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
