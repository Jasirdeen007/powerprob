[Unit]
Description=PowerProbe Raspberry Pi WebSocket Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/powerprobe
Environment=POWERPROBE_WS_URL=ws://YOUR_BACKEND_IP:8000/ws/pi
Environment=POWERPROBE_STATE_FILE=/home/pi/powerprobe/latest_profile.json
ExecStart=/usr/bin/python3 -u /home/pi/powerprobe/pi_command_client.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
